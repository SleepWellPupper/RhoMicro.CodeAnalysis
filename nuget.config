<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<config>
		<add key="globalPackagesFolder" value="feed/dev/" />
	</config>
	<packageSources>
		<clear />
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
		<add key="dev" value="dist/dev/" />
		<add key="External Cache" value="D:\nuget_packages" />
		<add key="Local Cache" value="C:\Users\PC\.nuget\packages" />
	</packageSources>
</configuration>
