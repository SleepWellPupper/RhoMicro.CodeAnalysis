<Project Sdk="Microsoft.NET.Sdk.Worker">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UserSecretsId>dotnet-WorkerService1-e2bcb5cd-902f-4d76-828b-e06aff08fdb1</UserSecretsId>
		<NoWarn>$(NoWarn);CS1591;CS1716;CA1716,CA1848;IDE0040</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
		<PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.0-preview.3.25171.5" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\OptionsGenerator\OptionsGenerator.csproj" 
						OutputItemType="analyzer"
						ReferenceOutputAssembly="false"/>
	</ItemGroup>
</Project>
